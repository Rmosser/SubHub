  {
   "row": "modify-url-rewrite#1.0",
   "label": "无项目",
   "bind": {
    "kind": "list",
    "ini": "URL Rewrite",
    "sep": " ",
    "label_col": 0,
    "sub_col": 2
   },
   "explain": "每行一条改写：匹配的网址、换成什么、用哪种方式。"
  },
  {
   "row": "modify-header-rewrite#1.0",
   "label": "无项目",
   "bind": {
    "kind": "list",
    "ini": "Header Rewrite",
    "sep": " ",
    "label_col": 1,
    "sub_col": 2,
    "max_cols": 3
   },
   "explain": "每行一条：匹配的网址，以及对哪个头做什么改动。",
   "todo": "采集时列表为空，手机上副标题的真实排版没见过"
  },
  {
   "row": "modify-body-rewrite#1.0",
   "label": "<URL 正则>",
   "bind": {
    "kind": "list",
    "ini": "Body Rewrite",
    "sep": " ",
    "match": "^http-(request|response)-jq\\s",
    "label_col": 1,
    "sub_col": [
     0,
     2
    ],
    "max_cols": 3
   },
   "explain": "用 jq 改写 JSON 响应，每行是 SubHub 写的一条。"
  },
  {
   "row": "modify-body-rewrite#1.1",
   "label": "<URL 正则>",
   "bind": {
    "kind": "list",
    "ini": "Body Rewrite",
    "sep": " ",
    "match": "^http-(request|response)\\s",
    "label_col": 1,
    "sub_col": [
     0,
     2
    ],
    "max_cols": 3
   },
   "explain": "用正则替换正文里的文字，每行是 SubHub 写的一条。",
   "todo": "这种行在 inventory 里没有详情屏（to 为空），点了不推入"
  },
  {
   "row": "modify-body-rewrite-edit#0.0",
   "label": "HTTP 方向",
   "bind": {
    "kind": "item",
    "ini": "Body Rewrite",
    "sep": " ",
    "col": 0,
    "map": {
     "http-request-jq": "Request",
     "http-request": "Request",
     "http-response-jq": "Response",
     "http-response": "Response"
    }
   },
   "explain": "改的是发出去的请求还是收到的响应，SubHub 已选好。"
  },
  {
   "row": "modify-body-rewrite-edit#0.1",
   "label": "修改模式",
   "bind": {
    "kind": "item",
    "ini": "Body Rewrite",
    "sep": " ",
    "col": 0,
    "map": {
     "http-request-jq": "JSON JQ",
     "http-response-jq": "JSON JQ",
     "http-request": "Text Regex",
     "http-response": "Text Regex"
    }
   },
   "explain": "按文字正则改还是按 JSON 结构改，SubHub 已选好。"
  },
  {
   "row": "modify-body-rewrite-edit#1.0",
   "label": "URL 正则",
   "bind": {
    "kind": "item",
    "ini": "Body Rewrite",
    "sep": " ",
    "col": 1,
    "max_cols": 3
   },
   "explain": "哪些网址会被改写，这条正则由 SubHub 写入。"
  },
  {
   "row": "modify-body-rewrite-edit#2.0",
   "label": "JQ 表达式",
   "bind": {
    "kind": "item",
    "ini": "Body Rewrite",
    "sep": " ",
    "col": 2,
    "max_cols": 3,
    "unquote": true
   },
   "explain": "具体怎么改 JSON，这段表达式由 SubHub 写入。"
  },
  {
   "row": "modify-mock#1.0",
   "label": "<URL 正则>",
   "bind": {
    "kind": "list",
    "ini": "Map Local",
    "sep": " ",
    "label_col": 0,
    "sub_param": "data"
   },
   "explain": "匹配到的网址不再联网，直接返回 SubHub 给的内容。",
   "todo": "[Map Local] 行是用户原样填的，data=/data-type= 的写法没有样本可核对"
  },
  {
   "row": "modify-mock-edit#0.0",
   "label": "URL 正则",
   "bind": {
    "kind": "item",
    "ini": "Map Local",
    "sep": " ",
    "col": 0
   },
   "explain": "哪些网址会被替换成本地内容，正则由 SubHub 写入。"
  },
  {
   "row": "modify-mock-edit#1.0",
   "label": "数据类型",
   "bind": {
    "kind": "item",
    "ini": "Map Local",
    "sep": " ",
    "param": "data-type"
   },
   "explain": "返回内容是文本还是文件，SubHub 按条目写好。",
   "todo": "缺 data-type 时手机默认显示哪一项未核对"
  },
  {
   "row": "modify-mock-edit#2.0",
   "label": "数据内容",
   "bind": {
    "kind": "item",
    "ini": "Map Local",
    "sep": " ",
    "param": "data",
    "unquote": true
   },
   "explain": "实际返回给 App 的内容，由 SubHub 写入。"
  },
  {
   "row": "home-proxies#0.0",
   "label": "<节点名>",
   "bind": {
    "kind": "list",
    "ini": "Proxy",
    "line": "kv-list",
    "label_part": "name",
    "sub_pos": [
     0,
     1
    ]
   },
   "explain": "一个节点一行：名字、协议和服务器，全由 SubHub 写入。"
  },
  {
   "row": "home-proxies#2.0",
   "label": "UDP 回退行为",
   "bind": {
    "kind": "value",
    "ini": "General",
    "key": "udp-policy-not-supported-behaviour",
    "map": {
     "REJECT": "阻止",
     "DIRECT": "直连"
    }
   },
   "explain": "节点不支持 UDP 时怎么办，SubHub 固定写成阻止。",
   "todo": "DIRECT 对应的手机文案是推测"
  },
  {
   "row": "home-proxy-edit#0.0",
   "label": "名称",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "part": "name"
   },
   "explain": "节点在列表里显示的名字，由 SubHub 统一命名。"
  },
  {
   "row": "home-proxy-edit#1.0",
   "label": "代理类型",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "pos": 0,
    "map": {
     "ss": "Shadowsocks",
     "trojan": "Trojan",
     "vmess": "VMess",
     "tuic": "TUIC",
     "tuic-v5": "TUIC v5",
     "hysteria2": "Hysteria 2",
     "anytls": "AnyTLS",
     "wireguard": "WireGuard",
     "http": "HTTP",
     "https": "HTTPS",
     "socks5": "SOCKS5"
    }
   },
   "explain": "这个节点用哪种协议连接，SubHub 按来源写入。",
   "todo": "除 Shadowsocks 外的手机文案是推测"
  },
  {
   "row": "home-proxy-edit#2.0",
   "label": "服务器地址",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "pos": 1
   },
   "explain": "节点服务器的地址，SubHub 按来源写入。"
  },
  {
   "row": "home-proxy-edit#2.1",
   "label": "端口号",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "pos": 2
   },
   "explain": "节点服务器的端口，SubHub 按来源写入。"
  },
  {
   "row": "home-proxy-edit#2.2",
   "label": "加密方式",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "param": "encrypt-method"
   },
   "explain": "节点的加密算法，要和服务器一致，SubHub 写入。"
  },
  {
   "row": "home-proxy-edit#2.3",
   "label": "密码",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "param": "password",
    "mask": true
   },
   "explain": "连接节点用的密码，SubHub 写入，这里默认打码。"
  },
  {
   "row": "home-proxy-edit#2.4",
   "label": "UDP Relay",
   "bind": {
    "kind": "item",
    "ini": "Proxy",
    "line": "kv-list",
    "param": "udp-relay"
   },
   "explain": "这个节点是否转发 UDP 流量，SubHub 按节点写入。"
  },
  {
   "row": "home-rules#1.0",
   "label": "<规则值>",
   "bind": {
    "kind": "list",
    "ini": "Rule",
    "sep": ",",
    "match": "^(?!FINAL,)",
    "label_col": 1,
    "sub_col": [
     0,
     2
    ]
   },
   "explain": "从上往下匹配，命中就走后面的策略，SubHub 写入。"
  },
  {
   "row": "home-rules#1.1",
   "label": "默认策略",
   "bind": {
    "kind": "value",
    "ini": "Rule",
    "match": "^FINAL,",
    "sep": ",",
    "col": 1
   },
   "explain": "前面都没命中时走哪个策略，SubHub 写在最后一行。"
  },
  {
   "row": "home-rules#2.0",
   "label": "在 DNS 失败时使用默认策略",
   "bind": {
    "kind": "exists",
    "ini": "Rule",
    "match": "^FINAL,.*\\bdns-failed\\b"
   },
   "explain": "域名查不到时也走默认策略，SubHub 写成了开。"
  },
  {
   "row": "home-dns#0.0",
   "label": "使用系统 DNS 服务器",
   "bind": {
    "kind": "exists",
    "ini": "General",
    "key": "dns-server",
    "re": "^\\s*system\\s*$"
   },
   "explain": "只用系统给的 DNS，SubHub 没写别的服务器时选它。",
   "todo": "SubHub 不写 dns-server 时手机选中哪一项未核对"
  },
  {
   "row": "home-dns#0.1",
   "label": "使用自定义 DNS 服务器",
   "bind": {
    "kind": "exists",
    "ini": "General",
    "key": "dns-server",
    "re": "^(?!.*\\bsystem\\b).+$"
   },
   "explain": "只用下面列出的 DNS，SubHub 写了服务器就选它。"
  },
  {
   "row": "home-dns#0.2",
   "label": "混合系统和自定义 DNS 服务器",
   "bind": {
    "kind": "exists",
    "ini": "General",
    "key": "dns-server",
    "re": "\\bsystem\\b\\s*,|,\\s*system\\b"
   },
   "explain": "系统 DNS 和下面列的一起用，SubHub 都写时选它。"
  },
  {
   "row": "home-dns#1.0",
   "label": "<DNS 地址>",
   "bind": {
    "kind": "list",
    "ini": "General",
    "key": "dns-server",
    "split": ","
   },
   "explain": "查域名用的服务器，每行一个，由 SubHub 写入。"
  },
  {
   "row": "home-dns#2.0",
   "label": "加密 DNS",
   "bind": {
    "kind": "value",
    "ini": "General",
    "key": "encrypted-dns-server"
   },
   "explain": "用加密方式查域名的服务器，SubHub 写了就优先用它。"
  },
  {
   "row": "home-local-dns#1.0",
   "label": "无项目",
   "bind": {
    "kind": "list",
    "ini": "Host",
    "sep": "=",
    "label_col": 0,
    "sub_col": 1
