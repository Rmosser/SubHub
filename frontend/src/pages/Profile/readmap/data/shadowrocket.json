  "home-node-edit": {
   "id": "home-node-edit",
   "title": "编辑节点",
   "parent": "tab-home",
   "via": "tab-home#1.1",
   "kind": "form",
   "sheet": false,
   "nav": {
    "left": "back",
    "right": "save"
   },
   "groups": [
    {
     "rows": [
      {
       "id": "home-node-edit#0.0",
       "label": "类型",
       "ctl": "disclosure",
       "rel": "w",
       "layer": "p",
       "acc": "chevron",
       "bind": {
        "kind": "item",
        "ini": "Proxy",
        "line": "kv-list",
        "pos": 0,
        "map": {
         "vless": "VLESS",
         "vmess": "VMess",
         "ss": "Shadowsocks",
         "trojan": "Trojan",
         "tuic": "TUIC",
         "hysteria2": "Hysteria2",
         "wireguard": "WireGuard",
         "http": "HTTP",
         "https": "HTTPS",
         "socks5": "SOCKS5"
        }
       },
       "explain": "这个节点用哪种协议连接。"
      }
     ]
    },
    {
     "footer": "Xray-core 支持 XTLS。V2ray-core 仅在 v4.32.0 和 v4.32.1 版本支持 XTLS。",
     "rows": [
      {
       "id": "home-node-edit#1.0",
       "label": "地址",
       "ctl": "textfield",
       "rel": "w",
       "layer": "p",
       "bind": {
        "kind": "item",
        "ini": "Proxy",
        "line": "kv-list",
        "pos": 1
       },
       "explain": "节点服务器的地址。"
      },
      {
       "id": "home-node-edit#1.1",
       "label": "端口",
       "ctl": "textfield",
       "rel": "w",
       "layer": "p",
       "bind": {
        "kind": "item",
        "ini": "Proxy",
        "line": "kv-list",
        "pos": 2
       },
       "explain": "节点服务器的端口。"
      },
      {
       "id": "home-node-edit#1.2",
       "label": "UUID",
       "ctl": "textfield",
       "rel": "w",
       "layer": "p",
       "bind": {
        "kind": "item",
        "ini": "Proxy",
        "line": "kv-list",
        "param": "password",
        "mask": true
       },
       "explain": "连接这个节点的身份凭证。"
      },
      {
       "id": "home-node-edit#1.3",
       "label": "加密",
       "ctl": "textfield",
       "rel": "u",
       "layer": "p",
       "about": "节点的加密参数，按服务器要求填，可留空。"
      },
      {
       "id": "home-node-edit#1.4",
       "label": "流控",
       "ctl": "disclosure",
       "rel": "u",
       "layer": "p",
       "about": "节点的流控方式，要和服务器一致。",
       "acc": "chevron"
      },
      {
       "id": "home-node-edit#1.5",
       "label": "传输方式",
       "ctl": "disclosure",
       "rel": "u",
       "layer": "p",
       "about": "数据走哪种传输层，如 WebSocket、gRPC。",
       "acc": "chevron"
      },
      {
       "id": "home-node-edit#1.6",
       "label": "TLS",
       "ctl": "disclosure",
       "rel": "u",
       "layer": "p",
       "about": "TLS 相关设置，如 SNI、证书校验、指纹。",
       "acc": "chevron"
      },
      {
       "id": "home-node-edit#1.7",
       "label": "多路复用",
       "ctl": "toggle",
       "rel": "u",
       "layer": "p",
       "about": "让多条连接共用一条通道传输。",
       "acc": "switch"
      },
      {
       "id": "home-node-edit#1.8",
       "label": "TCP 快速打开",
       "ctl": "toggle",
       "rel": "u",
       "layer": "p",
       "about": "建连时少等一次往返，需服务器支持。",
       "acc": "switch"
      },
      {
       "id": "home-node-edit#1.9",
       "label": "UDP 转发",
       "ctl": "disclosure",
       "rel": "w",
       "layer": "p",
       "acc": "chevron",
       "bind": {
        "kind": "item",
        "ini": "Proxy",
        "line": "kv-list",
        "param": "udp",
        "map": {
         "1": "开启",
         "0": "关闭"
        }
       },
       "explain": "这个节点是否转发 UDP 流量。"
      },
      {
       "id": "home-node-edit#1.10",
       "label": "代理通过",
       "ctl": "disclosure",
       "rel": "u",
       "layer": "p",
       "about": "先经另一个代理，再连到这个节点。",
       "acc": "chevron"
      },
      {
       "id": "home-node-edit#1.11",
       "label": "备注",
       "ctl": "textfield",
       "rel": "w",
       "layer": "p",
       "bind": {
        "kind": "item",
        "ini": "Proxy",
        "line": "kv-list",
        "part": "name"
       },
       "explain": "节点在列表里显示的名字，由 SubHub 统一命名。"
      }
     ]
    },
    {
     "rows": [
      {
       "id": "home-node-edit#2.0",
       "label": "分享节点",
       "ctl": "action",
       "rel": "",
       "layer": "x",
       "about": "把这个节点分享出去。"
      },
      {
       "id": "home-node-edit#2.1",
       "label": "复制 JSON",
       "ctl": "action",
       "rel": "",
       "layer": "x",
       "about": "把节点参数以 JSON 文本复制到剪贴板。"
      },
      {
       "id": "home-node-edit#2.2",
       "label": "复制网址",
       "ctl": "action",
       "rel": "",
       "layer": "x",
       "about": "把节点链接复制到剪贴板。"
      }
     ]
    },
    {
     "rows": [
      {
       "id": "home-node-edit#3.0",
       "label": "删除",
       "ctl": "button",
       "rel": "",
       "layer": "x",
       "about": "删除这个节点。"
      }
     ]
    }
   ],
   "shell": {
    "nav:save": "保存在手机上改过的节点参数。App 自己的操作，SubHub 不写它。"
   }
  },
