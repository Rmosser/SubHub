  "config-general": {
   "id": "config-general",
   "title": "通用",
   "parent": "config-edit",
   "via": "config-edit#0.0",
   "kind": "form",
   "sheet": false,
   "nav": {
    "left": "back",
    "right": "tick"
   },
   "groups": [
    {
     "footer": "启用完整的 IPv6 支持。",
     "rows": [
      {
       "id": "config-general#0.0",
       "label": "启用 IPv6",
       "ctl": "toggle",
       "rel": "w",
       "layer": "p",
       "acc": "switch",
       "bind": {
        "kind": "value",
        "ini": "General",
        "key": "ipv6"
       },
       "explain": "IPv6 开关。实测写成关，不一定能真正关掉 IPv6。"
      },
      {
       "id": "config-general#0.1",
       "label": "首选 IPv6",
       "ctl": "toggle",
       "rel": "n",
       "layer": "p",
       "about": "两种地址都有时，优先用 IPv6。",
       "acc": "switch"
      }
     ]
    },
    {
     "footer": "如果关闭该选项，域名解析返回私有 IP，Shadowrocket 会认为该域名被劫持而强制使用代理。",
     "rows": [
      {
       "id": "config-general#1.0",
       "label": "私有 IP 应答",
       "ctl": "toggle",
       "rel": "n",
       "layer": "p",
       "about": "允许域名解析出内网地址；关掉时这类域名强制走代理。",
       "acc": "switch"
      }
     ]
    },
    {
     "header": "DNS 覆写",
     "footer": "你可以使用此选项覆盖默认的DNS服务器。 iOS 系统不允许你在蜂窝网络上修改 DNS 设置。现在使用 Shadowrocket 你可以很容易地做到这一点。",
     "rows": [
      {
       "id": "config-general#2.0",
       "label": "system",
       "ctl": "textfield",
       "rel": "n",
       "layer": "p",
       "about": "已添加的 DNS 服务器，用来替代系统默认 DNS。"
      },
      {
       "id": "config-general#2.1",
       "label": "以逗号分隔",
       "ctl": "textfield",
       "rel": "n",
       "layer": "p",
       "about": "在这里添加 DNS 服务器，多个用逗号分隔。"
      }
     ]
    },
    {
     "header": "直连 DNS",
     "footer": "直连 DNS 用于解析匹配直连域名规则的域名。如果解析失败，将使用回退 DNS。",
     "rows": [
      {
       "id": "config-general#3.0",
       "label": "以逗号分隔",
       "ctl": "textfield",
       "rel": "n",
